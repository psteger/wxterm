{
  "version": 8,
  "name": "omt-dark",
  "_comment": "mapscii's dark.json (Mapbox Streets v7 schema) translated to the OpenMapTiles schema served by OpenFreeMap. Same colors; layer names and filter fields remapped: road->transportation (structure->brunnel, link->ramp), admin->boundary, *_label->place/poi/water_name/transportation_name/aerodrome_label/housenumber.",
  "constants": {
    "@background": "#000",
    "@water": "#5f87ff",
    "@waterway": "#a0c8f0",
    "@waterway_river": "#a0c8f0",
    "@waterway_stream_canal": "#a0c8f0",
    "@park": "#d8e8c8",
    "@landuse_park": "#7b5",
    "@landuse_cemetery": "#e0e4dd",
    "@landuse_hospital": "#d9b",
    "@landuse_school": "#f0e8f8",
    "@landcover_wood": "#6a4",
    "@aeroway": "#f0ede9",
    "@building": "#99b",
    "@tunnel_motorway": "#ffdaa6",
    "@tunnel_motorway_link": "#fc8",
    "@tunnel_trunk_primary": "#fff4c6",
    "@tunnel_secondary_tertiary": "#fff4c6",
    "@tunnel_street": "#fff",
    "@tunnel_service_track": "#fff",
    "@tunnel_path": "#cba",
    "@tunnel_rail": "#bbb",
    "@bridge_motorway": "#fc8",
    "@bridge_motorway_link": "#fc8",
    "@bridge_trunk_primary": "#fea",
    "@bridge_secondary_tertiary": "#fea",
    "@bridge_street": "#fff",
    "@bridge_service_track": "#fff",
    "@bridge_path": "#cba",
    "@bridge_rail": "#bbb",
    "@road_motorway": "#fc8",
    "@road_motorway_link": "#fc8",
    "@road_trunk_primary": "#fea",
    "@road_secondary_tertiary": "#fea",
    "@road_street": "#fff",
    "@road_service_track": "#fff",
    "@road_path": "#cba",
    "@road_rail": "#bbb",
    "@admin_level_2": "#fff",
    "@admin_level_2_disputed": "#fff",
    "@admin_level_2_maritime": "#9bf",
    "@admin_level_3": "#aac",
    "@admin_level_3_maritime": "#8af",
    "@admin_level_4": "#777",
    "@water_label": "#74aee9",
    "@country_label": "#ff0",
    "@place_label_city": "#f00",
    "@place_label_town": "#d33",
    "@place_label_village": "#c33",
    "@place_label_other": "#b33",
    "@airport_label": "#666",
    "@poi_label_1": "#ff0",
    "@poi_label_2": "#ee0",
    "@poi_label_3": "#cc0",
    "@poi_label_4": "#aa0",
    "@road_label": "#765"
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "@background" } },

    { "id": "park", "type": "fill", "source-layer": "park", "minzoom": 9,
      "paint": { "fill-color": "@park" } },
    { "id": "landuse_park", "type": "fill", "source-layer": "landuse",
      "filter": ["==", "class", "park"], "paint": { "fill-color": "@landuse_park" } },
    { "id": "landuse_cemetery", "type": "line", "source-layer": "landuse",
      "filter": ["==", "class", "cemetery"], "paint": { "line-color": "@landuse_cemetery" } },
    { "id": "landuse_hospital", "type": "line", "source-layer": "landuse",
      "filter": ["==", "class", "hospital"], "paint": { "line-color": "@landuse_hospital" } },
    { "id": "landuse_school", "type": "line", "source-layer": "landuse",
      "filter": ["==", "class", "school"], "paint": { "line-color": "@landuse_school" } },
    { "id": "landcover_wood", "type": "line", "source-layer": "landcover", "minzoom": 9,
      "filter": ["==", "class", "wood"], "paint": { "line-color": "@landcover_wood" } },

    { "id": "waterway_river", "type": "line", "source-layer": "waterway",
      "filter": ["==", "class", "river"], "paint": { "line-color": "@waterway_river" } },
    { "id": "waterway_stream_canal", "type": "line", "source-layer": "waterway",
      "filter": ["in", "class", "stream", "canal"], "paint": { "line-color": "@waterway_stream_canal" } },
    { "id": "waterway_other", "type": "line", "source-layer": "waterway",
      "paint": { "line-color": "@waterway" } },
    { "id": "water", "type": "fill", "source-layer": "water",
      "paint": { "fill-color": "@water" } },

    { "id": "aeroway_fill", "type": "fill", "source-layer": "aeroway", "minzoom": 11,
      "filter": ["==", "$type", "Polygon"], "paint": { "fill-color": "@aeroway" } },
    { "id": "aeroway_runway", "type": "line", "source-layer": "aeroway", "minzoom": 11,
      "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "runway"]],
      "paint": { "line-color": "@aeroway" } },
    { "id": "aeroway_taxiway", "type": "line", "source-layer": "aeroway", "minzoom": 11,
      "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "taxiway"]],
      "paint": { "line-color": "@aeroway" } },

    { "id": "building", "type": "line", "source-layer": "building",
      "paint": { "line-color": "@building" } },

    { "id": "tunnel_path", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"], ["==", "class", "path"]],
      "paint": { "line-color": "@tunnel_path" } },
    { "id": "tunnel_motorway_link", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"], ["==", "class", "motorway"], ["==", "ramp", 1]],
      "paint": { "line-color": "@tunnel_motorway_link" } },
    { "id": "tunnel_service_track", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"], ["in", "class", "service", "track"]],
      "paint": { "line-color": "@tunnel_service_track" } },
    { "id": "tunnel_street", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"], ["==", "class", "minor"]],
      "paint": { "line-color": "@tunnel_street" } },
    { "id": "tunnel_secondary_tertiary", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"], ["in", "class", "secondary", "tertiary"]],
      "paint": { "line-color": "@tunnel_secondary_tertiary" } },
    { "id": "tunnel_trunk_primary", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"], ["in", "class", "trunk", "primary"]],
      "paint": { "line-color": "@tunnel_trunk_primary" } },
    { "id": "tunnel_motorway", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"], ["==", "class", "motorway"]],
      "paint": { "line-color": "@tunnel_motorway" } },
    { "id": "tunnel_rail", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"], ["==", "class", "rail"]],
      "paint": { "line-color": "@tunnel_rail" } },

    { "id": "bridge_path", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "bridge"], ["==", "class", "path"]],
      "paint": { "line-color": "@bridge_path" } },
    { "id": "bridge_motorway_link", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "bridge"], ["==", "class", "motorway"], ["==", "ramp", 1]],
      "paint": { "line-color": "@bridge_motorway_link" } },
    { "id": "bridge_service_track", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "bridge"], ["in", "class", "service", "track"]],
      "paint": { "line-color": "@bridge_service_track" } },
    { "id": "bridge_street", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "bridge"], ["==", "class", "minor"]],
      "paint": { "line-color": "@bridge_street" } },
    { "id": "bridge_secondary_tertiary", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "bridge"], ["in", "class", "secondary", "tertiary"]],
      "paint": { "line-color": "@bridge_secondary_tertiary" } },
    { "id": "bridge_trunk_primary", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "bridge"], ["in", "class", "trunk", "primary"]],
      "paint": { "line-color": "@bridge_trunk_primary" } },
    { "id": "bridge_motorway", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "bridge"], ["==", "class", "motorway"]],
      "paint": { "line-color": "@bridge_motorway" } },
    { "id": "bridge_rail", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "bridge"], ["==", "class", "rail"]],
      "paint": { "line-color": "@bridge_rail" } },

    { "id": "road_path", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "class", "path"], ["!in", "brunnel", "bridge", "tunnel"]],
      "paint": { "line-color": "@road_path" } },
    { "id": "road_motorway_link", "type": "line", "source-layer": "transportation", "minzoom": 12,
      "filter": ["all", ["==", "class", "motorway"], ["==", "ramp", 1], ["!in", "brunnel", "bridge", "tunnel"]],
      "paint": { "line-color": "@road_motorway_link" } },
    { "id": "road_service_track", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["in", "class", "service", "track"], ["!in", "brunnel", "bridge", "tunnel"]],
      "paint": { "line-color": "@road_service_track" } },
    { "id": "road_street", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "class", "minor"], ["!in", "brunnel", "bridge", "tunnel"]],
      "paint": { "line-color": "@road_street" } },
    { "id": "road_secondary_tertiary", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["in", "class", "secondary", "tertiary"], ["!in", "brunnel", "bridge", "tunnel"]],
      "paint": { "line-color": "@road_secondary_tertiary" } },
    { "id": "road_trunk_primary", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["in", "class", "trunk", "primary"], ["!in", "brunnel", "bridge", "tunnel"]],
      "paint": { "line-color": "@road_trunk_primary" } },
    { "id": "road_motorway", "type": "line", "source-layer": "transportation", "minzoom": 5,
      "filter": ["all", ["==", "class", "motorway"], ["!in", "brunnel", "bridge", "tunnel"]],
      "paint": { "line-color": "@road_motorway" } },
    { "id": "road_rail", "type": "line", "source-layer": "transportation",
      "filter": ["all", ["==", "class", "rail"], ["!in", "brunnel", "bridge", "tunnel"]],
      "paint": { "line-color": "@road_rail" } },

    { "id": "boundary_level_6", "type": "line", "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 6], ["==", "maritime", 0]],
      "paint": { "line-color": "@admin_level_4" } },
    { "id": "boundary_level_4", "type": "line", "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 4], ["==", "maritime", 0]],
      "paint": { "line-color": "@admin_level_3" } },
    { "id": "boundary_level_3", "type": "line", "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 3], ["==", "maritime", 0]],
      "paint": { "line-color": "@admin_level_3" } },
    { "id": "boundary_level_2", "type": "line", "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 2], ["==", "disputed", 0], ["==", "maritime", 0]],
      "paint": { "line-color": "@admin_level_2" } },
    { "id": "boundary_level_2_disputed", "type": "line", "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 2], ["==", "disputed", 1], ["==", "maritime", 0]],
      "paint": { "line-color": "@admin_level_2_disputed" } },
    { "id": "boundary_level_3_maritime", "type": "line", "source-layer": "boundary",
      "filter": ["all", [">=", "admin_level", 3], ["==", "maritime", 1]],
      "paint": { "line-color": "@admin_level_3_maritime" } },
    { "id": "boundary_level_2_maritime", "type": "line", "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 2], ["==", "maritime", 1]],
      "paint": { "line-color": "@admin_level_2_maritime" } },

    { "id": "water_name", "type": "symbol", "source-layer": "water_name",
      "paint": { "text-color": "@water_label" } },
    { "id": "place_country", "type": "symbol", "source-layer": "place",
      "filter": ["==", "class", "country"], "paint": { "text-color": "@country_label" } },
    { "id": "place_city", "type": "symbol", "source-layer": "place",
      "filter": ["==", "class", "city"], "paint": { "text-color": "@place_label_city" } },
    { "id": "place_town", "type": "symbol", "source-layer": "place",
      "filter": ["==", "class", "town"], "paint": { "text-color": "@place_label_town" } },
    { "id": "place_village", "type": "symbol", "source-layer": "place",
      "filter": ["==", "class", "village"], "paint": { "text-color": "@place_label_village" } },
    { "id": "place_other", "type": "symbol", "source-layer": "place",
      "filter": ["in", "class", "hamlet", "suburb", "neighbourhood", "quarter", "island", "islet"],
      "paint": { "text-color": "@place_label_other" } },
    { "id": "aerodrome_label", "type": "symbol", "source-layer": "aerodrome_label", "minzoom": 11,
      "paint": { "text-color": "@airport_label" } },
    { "id": "poi_rank1", "type": "symbol", "source-layer": "poi", "minzoom": 13,
      "filter": ["<=", "rank", 5], "paint": { "text-color": "@poi_label_1" } },
    { "id": "poi_rank2", "type": "symbol", "source-layer": "poi", "minzoom": 14,
      "filter": ["<=", "rank", 10], "paint": { "text-color": "@poi_label_2" } },
    { "id": "poi_rank3", "type": "symbol", "source-layer": "poi", "minzoom": 15,
      "filter": ["<=", "rank", 15], "paint": { "text-color": "@poi_label_3" } },
    { "id": "poi_rank4", "type": "symbol", "source-layer": "poi", "minzoom": 16,
      "paint": { "text-color": "@poi_label_4" } },
    { "id": "transportation_name", "type": "symbol", "source-layer": "transportation_name", "minzoom": 15.5,
      "filter": ["!=", "class", "ferry"], "paint": { "text-color": "@road_label" } }
  ]
}
